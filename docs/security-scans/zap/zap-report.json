							"nodeName": "http:\/\/host.docker.internal:8000\/api\/v1\/files ()({encrypted_filename,filename_nonce,size_bytes,chunk_size,num_chunks,ephemeral_public_key,wrapped_key,wrap_nonce})",
							"method": "POST",
